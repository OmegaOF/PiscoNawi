# Database Configuration
DATABASE_URL=mysql+pymysql://root:root@localhost:3307/pisco-nawi

# JWT Secret Key
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-123456789

MODELO_API_KEY=your-model-api-key-here
MODELO_BASE_URL=https://tu-proveedor-modelo.com/v1/chat/completions
MODELO_NOMBRE=ModeloCNNbinario
MODELO_DECISOR_ID=nombre-del-modelo

# Servicio adicional de análisis de imágenes
CNN_MODEL_STEP_INFO=tu-clave-del-servicio
CNN_MODEL_STEP_URL=https://tu-servicio-de-analisis/v1/chat/completions
CNN_MODEL_STEP_VERSION=nombre-del-modelo
# Opcionales (valores por defecto: medium y 16000):
# CNN_MODEL_STEP_REASONING=medium      # minimal | low | medium | high
# CNN_MODEL_STEP_MAX_TOKENS=16000
# Registro en consola (por defecto silencioso). Para depurar: LOG_LEVEL=DEBUG
# LOG_LEVEL=WARNING
# PROCESS_WAVE_DEBUG=1

# Captura de vehículos (YOLO)
# Índice de cámara por defecto si no se selecciona ninguna en la interfaz
# CAMERA_INDEX=0
# Cuántos índices de cámara probar (0..N-1) al listar dispositivos disponibles
# MAX_CAMARAS=4
